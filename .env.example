# ── SDA Vision configuration ─────────────────────────────────────────────
# Copy this file to ".env" and paste your keys. Every provider is optional:
# the app runs whatever is configured and shows the rest as "unconfigured".
# It never falls back silently — every provider always appears in the table.

# ── Vision models ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-opus-5-5
# Optional pasted-note scoring stays on the small, pinned model.
ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5-20251001

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-astra

# Google AI Studio key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GOOGLE_VISION_MODEL=gemini-3.8-flash

# Legacy custom watermark adapter. Leave blank: these are NOT a drop-in setting
# for Google's statistical detection API or OpenAI's content-provenance API.
# A new integration needs its own reviewed contract, consent and retention check.
SYNTHID_ENDPOINT=
SYNTHID_ACCESS_TOKEN=

# ── Behaviour ───────────────────────────────────────────────────────────────
# Per-provider hard timeout in seconds (so one slow API never blocks the others).
PROVIDER_TIMEOUT=60
# Network retries per vision call on transient failure.
PROVIDER_RETRIES=1
PORT=8100

# Max frames sampled from a PDF / PPTX / video before running vision on each.
# Each frame = one call per configured vision provider, so this bounds cost.
MAX_FRAMES=4

# PDF handling: "auto" extracts embedded figures (good for journal papers with
# doctored figures) and falls back to page rendering when none are found;
# "figures" or "pages" force a mode. MIN_FIGURE_PX filters out logos/banners.
PDF_MODE=auto
MIN_FIGURE_PX=300

# Audio: transcoded to mono 16 kHz and capped to this many seconds before
# transcription (Gemini-native preferred, OpenAI Whisper fallback).
AUDIO_MAX_SECONDS=1800
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Disable a provider explicitly (still shown in the table as "disabled").
# DISABLE_ANTHROPIC=true
# DISABLE_OPENAI=true
# DISABLE_GOOGLE=true

# Gated research lens. Off by default so the shipped tool reads as a general,
# open instrument. Turn on only for the fellowship case study / workshops; it
# adds vaccine-and-health framing codes for human review (not a classifier).
# ENABLE_VACCINE_LENS=true

# Dev mode (your machine only). ON exposes the local labelled-corpus browser and
# saves each analysis to dev_runs/ for the next phase of analysis. OFF (the
# shipped/public default) hides the corpus and saves nothing. Uploads work either
# way. Leave this OFF for the public GitHub build.
# DEV_MODE=true

# Dev-mode labelled corpus (never bundled — private/licensed media). Point this
# at your own corpus folder to enable the in-app corpus browser. If unset, the
# corpus browser is simply unavailable.
# CORPUS_DIR=/absolute/path/to/labelled-corpus
