.DS_Store
__pycache__/
*.pyc
.venv/
venv/
.env
.env.*
!.env.example

# Machine-local agent settings, caches and process state are not source.
.claude/
.pytest_cache/
.local-safety/
.review-cache/
trust-store/
*.pid

# Research corpora can contain copyrighted, private, or licensed media.
labelled-corpus/
labelled-corpus/**/*.jpg
labelled-corpus/**/*.jpeg
labelled-corpus/**/*.png
labelled-corpus/**/*.webp
labelled-corpus/**/*.gif
labelled-corpus/**/*.heic
labelled-corpus/**/*.mp4
labelled-corpus/**/*.mov

# Generated reports + research artifacts. May contain corpus-derived data,
# real labels, or face-review contact sheets, so none of it ships.
reports/*
!reports/.gitkeep

# Dev-mode saved analyses (researcher's own machine; never shipped)
dev_runs/

# Local server / debug logs can capture request URLs (incl. an API key passed in
# a query string) or media-derived text. Never ship them.
*.log
server.log

# Frontend deps; the built bundle (frontend/dist) IS committed for non-coders
/frontend/node_modules

# tsc -b side-emissions: a stray vite.config.js would silently SHADOW
# vite.config.ts (Vite 5 prefers .js), so never commit these.
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/*.tsbuildinfo

# Static showcase build artifacts (regenerated by scripts/bake_showcase.py +
# scripts/build_showcase.sh). The deployable folders are frontend/dist-showcase
# (public demo) and frontend/dist-showcase-workshop (facilitator-led sessions).
frontend/showcase-data/
frontend/dist-showcase/
frontend/dist-showcase-workshop/

# Pre-demo check state: the accepted corpus baseline is personal to this
# machine's corpus, so it is never shared (./preflight.command --accept).
preflight/

# Local visual review evidence may contain material from analysed documents.
docs/review-*/**/*.png
docs/review-*/*.png

# Bundled public example media (examples/) is committed on purpose.
# Personal film supplied for local provenance testing, not publication.
/examples/dreamina-2026-09-24-5525-*.mp4
# Evaluation clips and generation-download images require explicit asset clearance.
/examples/*.mp4
/examples/*httpss.mj.run*.png
# New audio research samples need separate rights clearance; existing tracked examples stay tracked.
/examples/*.mp3
/examples/*.wav
/examples/*.m4a
# Researcher-selected podcast in the private, hash-checked example bundle.
!/examples/podcast.m4a

# Local collaboration guidance stays outside repositories and release packages.
AGENTS.md
CONTRIBUTING.md
